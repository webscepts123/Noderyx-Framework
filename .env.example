# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
NODE_ENV=development
APP_DEBUG=true
APP_KEY=
APP_NAME="Noderyx App"
APP_URL=http://localhost:3000
APP_TIMEZONE=UTC
APP_LOCALE=en
LOG_LEVEL=debug

SITE_NAME="Noderyx App"
SITE_URL=http://localhost:3000
SITE_DESCRIPTION="Built with Noderyx Framework."
HOST=0.0.0.0
PORT=3000

# -----------------------------------------------------------------------------
# AI (optional, server-side only)
# Never place an API key in browser JavaScript or commit your .env file.
# AI_PROVIDER selects which block below is used: openai or anthropic (claude).
# -----------------------------------------------------------------------------
AI_ENABLED=false
AI_PROVIDER=openai

# Used when AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_BASE_URL=https://api.openai.com/v1

# Used when AI_PROVIDER=anthropic (Claude)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
ANTHROPIC_BASE_URL=https://api.anthropic.com/v1
ANTHROPIC_FALLBACKS=true

# Shared by both providers
AI_REASONING_EFFORT=medium
AI_VERBOSITY=medium
AI_MAX_OUTPUT_TOKENS=1200
AI_INPUT_LIMIT=8000
AI_TIMEOUT_MS=30000
AI_STORE=false
AI_INSTRUCTIONS="Be practical, concise, and honest."

# With Claude, thinking tokens count toward AI_MAX_OUTPUT_TOKENS. Raise it to
# 4000 or more, or set AI_REASONING_EFFORT=none, to avoid truncated answers.

# Forge APP_KEY with the Noderyx command: npx noderyx spark:key
# Production must use NODE_ENV=production, APP_DEBUG=false, and a unique APP_KEY.

# -----------------------------------------------------------------------------
# Database: mysql, postgres, or mongo
# -----------------------------------------------------------------------------
DB_TYPE=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=noderyx_app
DB_POOL_MIN=0
DB_POOL_MAX=10

# Used when DB_TYPE=postgres
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/noderyx_app

# Used when DB_TYPE=mongo
MONGODB_URL=mongodb://127.0.0.1:27017

# -----------------------------------------------------------------------------
# Cache: memory or none
# Values are seconds except CACHE_MAX_ITEMS.
# -----------------------------------------------------------------------------
CACHE_DRIVER=memory
CACHE_PREFIX=noderyx
CACHE_TTL=3600
CACHE_MAX_ITEMS=512
CACHE_STATIC_MAX_AGE=86400
CACHE_STALE_WHILE_REVALIDATE=604800

# -----------------------------------------------------------------------------
# Email
# MAIL_DRIVER=log is safe for development. An SMTP package may consume these.
# -----------------------------------------------------------------------------
MAIL_DRIVER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="Noderyx App"

# -----------------------------------------------------------------------------
# Security, sessions, CORS, proxy, and request limits
# -----------------------------------------------------------------------------
SECURITY_PROFILE=standard
TRUST_PROXY=false
CORS_ORIGINS=
REQUEST_BODY_LIMIT=1048576
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
SESSION_COOKIE=noderyx_session
SESSION_MAX_AGE=604800
SESSION_SAME_SITE=Lax
SESSION_SECURE=false

# Example: CORS_ORIGINS=https://app.example.com,capacitor://localhost

# -----------------------------------------------------------------------------
# Mobile and native applications
# -----------------------------------------------------------------------------
MOBILE_APP_ID=com.example.noderyxapp
MOBILE_APP_NAME="Noderyx App"
MOBILE_API_URL=http://localhost:3000
